# ---- Supabase (Project Settings → API) ---------------------------------
# Public values — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site URL (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ---------------
# Only used by the CLI scripts in /scripts (create-admin, seed). The web
# app itself never needs the service role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string, only for `npm run seed`
# (Project Settings → Database → Connection string → URI).
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
